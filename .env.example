# Copia este fichero a .env y ajusta los valores. .env NO se sube al repo.

# Puerto donde escucha el servidor (el Aidoo conecta aquí por TLS). 443 por defecto.
AIDOO_PORT=443

# Broker MQTT de Home Assistant (Mosquitto). Sin MQTT_HOST solo corre el servidor
# (sin entidad en HA). Con broker estándar de HA suele ser el add-on de Mosquitto.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=usuario
MQTT_PASS=clave

# Identidad/nombre de la entidad climate en Home Assistant
AIDOO_NODE=aidoo_lg
AIDOO_NAME=Aire LG (local)

# Rango de temperatura de la consigna
AIDOO_MIN_TEMP=16
AIDOO_MAX_TEMP=30
AIDOO_TEMP_STEP=0.5
